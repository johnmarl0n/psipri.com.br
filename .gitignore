# .gitignore para projetos ASP.NET Core e Visual Studio

# Build artifacts
[Bb]in/
[Oo]bj/
[Rr]elease/
[Pp]ublish/

# SQLite database (Excluir do repositório para evitar versionar dados locais)
*.db
*.db-shm
*.db-wal

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# IDE files
.vs/
.idea/
*.swp
*.lp

# Secret and configuration files (contém senhas de banco e SMTP)
appsettings.json
appsettings.Development.json

# Tooling and bundling
node_modules/
.sass-cache/
_Temp/
