@section Scripts {
    <script>
        // Interactive "Como se sente hoje" Logic
        const needDetails = {
            ansiedade: {
                title: "Ansiedade ou Sobrecarga Emocional",
                text: "Sentir o peito apertado, pensamentos acelerados e o peso de obrigações cotidianas constantes é um sinal de alerta do seu corpo. Na psicoterapia, trabalharemos juntos para identificar os gatilhos dessa sobrecarga, desenvolvendo recursos para acalmar a mente e restabelecer o equilíbrio e a paz interior.",
                ctaText: "Conversar sobre Ansiedade",
                ctaUrl: "https://wa.me/5519993364884?text=Olá Dra. Priscila. Sinto muita ansiedade e sobrecarga, e gostaria de saber como a terapia pode me ajudar."
            },
            relacionamento: {
                title: "Dificuldades de Relacionamento",
                text: "Conflitos frequentes com parceiros, desentendimentos familiares ou sentimentos de solidão minam nossa energia emocional. O atendimento clínico oferece um espaço de reflexão para compreender dinâmicas interpessoais, estabelecer limites saudáveis e restaurar canais de comunicação afetivos e eficientes.",
                ctaText: "Conversar sobre Relacionamentos",
                ctaUrl: "https://wa.me/5519993364884?text=Olá Dra. Priscila. Gostaria de saber mais sobre o atendimento para conflitos de relacionamento."
            },
            autocuidado: {
                title: "Autoconhecimento & Mudança de Vida",
                text: "Se você se sente perdido, sem rumo claro ou deseja mudar velhos hábitos que travam seu potencial, o processo de autoconhecimento é o caminho ideal. Vamos explorar juntos seus valores reais, romper crenças limitantes e definir escolhas alinhadas ao seu bem-estar profundo.",
                ctaText: "Iniciar Processo de Autoconhecimento",
                ctaUrl: "https://wa.me/5519993364884?text=Olá Dra. Priscila. Desejo iniciar meu processo de autoconhecimento na terapia."
            },
            juridico: {
                title: "Perícias & Assistência Técnica Judicial",
                text: "Processos judiciais complexos que envolvem disputas de guarda, alienação parental, assédio ou perícia por invalidez exigem acompanhamento técnico qualificado de um assistente de psicologia. Atuo na elaboração de quesitos específicos, análise de laudos e acompanhamento ético das perícias.",
                ctaText: "Solicitar Assistência Técnica",
                ctaUrl: "https://wa.me/5519993364884?text=Olá Dra. Priscila. Preciso de suporte especializado em perícia/assistência técnica judicial."
            }
        };

        const buttons = document.querySelectorAll('.need-tag-btn');
        const responseTitle = document.getElementById('needResponse').querySelector('.need-response-title');
        const responseText = document.getElementById('needResponse').querySelector('.need-response-text');
        const ctaBtn = document.getElementById('needCta');

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                buttons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const need = btn.getAttribute('data-need');
                const data = needDetails[need];

                responseTitle.textContent = data.title;
                responseText.textContent = data.text;
                ctaBtn.innerHTML = `<i class="fab fa-whatsapp"></i> ${data.ctaText}`;
                ctaBtn.setAttribute('href', data.ctaUrl);
            });
        });

        // FAQ & Specialties Accordion toggler
        document.querySelectorAll('.accordion-header').forEach(header => {
            header.addEventListener('click', () => {
                const item = header.parentElement;
                const isActive = item.classList.contains('active');
                
                // Toggle siblings if they are active
                const parent = item.parentElement;
                parent.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('active'));
                
                if (!isActive) {
                    item.classList.add('active');
                }
            });
        });
    </script>
}
