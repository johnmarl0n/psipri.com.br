@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index" style="font-weight: 600;">Painel Admin</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link btn-outline-discreet" asp-area="Identity" asp-page="/Account/Login">Acesso Restrito</a>
    </li>
}
</ul>
