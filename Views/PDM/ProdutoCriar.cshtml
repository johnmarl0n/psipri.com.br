@model psipri.com.br.Models.PDM.PDMProduto
@using psipri.com.br.Models.PDM.Enums
@{
    Layout = "_LayoutPDM";
}

<div style="margin-bottom: 24px;">
    <a href="/Admin/PDM/Produtos" class="pdm-btn pdm-btn-outline pdm-btn-sm">
        <i class="fas fa-arrow-left"></i> Voltar à Lista
    </a>
</div>

<div class="pdm-card" style="max-width: 800px; margin: 0 auto;">
    <form action="/Admin/PDM/Produto/Criar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div style="display: flex; gap: 30px; flex-wrap: wrap; margin-bottom: 30px;">
            <!-- Left col: Image Upload -->
            <div style="flex: 1; min-width: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid var(--pdm-border); padding-right: 30px;">
                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 12px; color: var(--pdm-dark);">Imagem do Insumo</label>
                
                <div class="pdm-image-preview-container" onclick="document.getElementById('imageFileInput').click()">
                    <img id="previewImage" style="display: none;" />
                    <div id="previewPlaceholder" class="pdm-image-preview-placeholder">
                        <i class="fas fa-image"></i>
                        <span>Escolher Imagem<br/><small>(Opcional)</small></span>
                    </div>
                </div>
                
                <input type="file" name="imagemFile" id="imageFileInput" style="display: none;" accept="image/*" />
                <p style="font-size: 0.75rem; color: var(--pdm-muted); text-align: center; margin-top: 12px; max-width: 180px;">
                    Selecione uma imagem quadrada para melhor visualização.
                </p>
            </div>

            <!-- Right col: Core Fields -->
            <div style="flex: 2; min-width: 300px;">
                <!-- Category Select -->
                <div class="pdm-form-group">
                    <label for="CategoriaId">Categoria *</label>
                    <select asp-for="CategoriaId" class="pdm-form-control" id="CategoriaId" required>
                        <option value="">-- Selecione uma Categoria --</option>
                        @foreach (var cat in ViewBag.Categorias)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    </select>
                    <span asp-validation-for="CategoriaId" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
                </div>

                <!-- Product Name -->
                <div class="pdm-form-group">
                    <label for="Nome">Nome do Insumo *</label>
                    <input asp-for="Nome" class="pdm-form-control" id="Nome" placeholder="Ex: Parafina de Soja Lentilhada" required />
                    <span asp-validation-for="Nome" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
                </div>

                <!-- Description -->
                <div class="pdm-form-group">
                    <label for="Descricao">Descrição</label>
                    <textarea asp-for="Descricao" class="pdm-form-control" id="Descricao" rows="3" placeholder="Informações adicionais do insumo, fabricante, etc."></textarea>
                    <span asp-validation-for="Descricao" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
                </div>
            </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--pdm-border); margin: 30px 0;" />

        <!-- Quantity & Price details -->
        <h3 class="serif" style="margin-bottom: 20px; color: var(--pdm-dark); font-size: 1.5rem;">Estoque e Custos</h3>
        
        <div class="pdm-form-grid" style="margin-bottom: 30px;">
            <div class="pdm-form-group">
                <label for="UnidadeMedida">Unidade de Medida *</label>
                <select asp-for="UnidadeMedida" class="pdm-form-control" id="UnidadeMedida" required>
                    <option value="@UnidadeMedida.KG">Quilo (kg)</option>
                    <option value="@UnidadeMedida.ML">Mililitro (ml)</option>
                    <option value="@UnidadeMedida.UN">Unidade (un)</option>
                    <option value="@UnidadeMedida.MT">Metro (mt)</option>
                </select>
                <span asp-validation-for="UnidadeMedida" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
            </div>

            <div class="pdm-form-group">
                <label for="QuantidadeEstoque">Qtd em Estoque *</label>
                <input asp-for="QuantidadeEstoque" type="number" step="0.0001" class="pdm-form-control" id="QuantidadeEstoque" required />
                <span asp-validation-for="QuantidadeEstoque" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
            </div>

            <div class="pdm-form-group">
                <label for="EstoqueMinimo">Estoque Mínimo *</label>
                <input asp-for="EstoqueMinimo" type="number" step="0.0001" class="pdm-form-control" id="EstoqueMinimo" required />
                <span asp-validation-for="EstoqueMinimo" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
            </div>
        </div>

        <div class="pdm-form-grid" style="margin-bottom: 40px; background-color: #fcf8f2; padding: 24px; border-radius: 16px; border: 1px solid #fef3c7;">
            <div class="pdm-form-group" style="margin-bottom: 0;">
                <label for="PrecoCusto">Preço de Custo (R$) *</label>
                <input asp-for="PrecoCusto" type="number" step="0.01" class="pdm-form-control" id="PrecoCusto" placeholder="0,00" required />
                <span asp-validation-for="PrecoCusto" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
            </div>

            <div class="pdm-form-group" style="margin-bottom: 0;">
                <label for="Margem">Margem de Lucro (%) *</label>
                <input asp-for="Margem" type="number" step="0.1" class="pdm-form-control" id="Margem" placeholder="60,0" required />
                <span asp-validation-for="Margem" style="color: var(--pdm-danger); font-size: 0.8rem;"></span>
            </div>

            <div class="pdm-form-group" style="margin-bottom: 0;">
                <label for="PrecoVendaCalculado">Preço Sugerido (Venda)</label>
                <input type="text" class="pdm-form-control" id="PrecoVendaCalculado" style="font-weight: 700; color: var(--pdm-primary-hover); background-color: #fff; cursor: not-allowed;" readonly />
            </div>
        </div>

        <div style="display: flex; gap: 15px; justify-content: flex-end;">
            <a href="/Admin/PDM/Produtos" class="pdm-btn pdm-btn-outline">Cancelar</a>
            <button type="submit" class="pdm-btn pdm-btn-primary">
                <i class="fas fa-save"></i> Salvar Insumo
            </button>
        </div>
    </form>
</div>
