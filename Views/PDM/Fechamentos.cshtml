@model IEnumerable<psipri.com.br.Models.PDM.PDMFechamento>
@{
    Layout = "_LayoutPDM";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
        <p style="color: var(--pdm-muted); margin: 0;">Grave a posição de estoque e valor financeiro de insumos de forma histórica.</p>
    </div>
    <div>
        <form action="/Admin/PDM/Fechamento/Criar" method="post" style="display: inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="pdm-btn pdm-btn-primary">
                <i class="fas fa-save"></i> Salvar Posição de Estoque
            </button>
        </form>
    </div>
</div>

<div class="pdm-card" style="padding: 0; overflow: hidden;">
    <div class="pdm-table-container" style="border: none; border-radius: 0;">
        <table class="pdm-table">
            <thead>
                <tr>
                    <th>Data do Fechamento</th>
                    <th style="text-align: right;">Quantidade de Itens Gravados</th>
                    <th style="text-align: right;">Valor Financeiro Total em Estoque</th>
                    <th style="text-align: center; width: 150px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 40px; color: var(--pdm-muted);">
                            <i class="fas fa-folder-open" style="font-size: 3rem; margin-bottom: 15px; display: block; color: #cbd5e1;"></i>
                            Nenhum fechamento de estoque registrado ainda. Clique no botão acima para salvar a posição atual.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td>
                                <div style="font-weight: 600; color: var(--pdm-dark);">@f.DataFechamento.ToString("dd/MM/yyyy")</div>
                                <div style="font-size: 0.8rem; color: var(--pdm-muted);">@f.DataFechamento.ToString("HH:mm")</div>
                            </td>
                            <td style="text-align: right; font-weight: 500;">
                                @(f.FechamentoItems?.Count ?? 0) itens
                            </td>
                            <td style="text-align: right; font-weight: 700; color: var(--pdm-primary-hover);">
                                @f.ValorTotalEstoque.ToString("C2")
                            </td>
                            <td style="text-align: center;">
                                <a href="/Admin/PDM/Fechamento/Detalhe/@f.Id" class="pdm-btn pdm-btn-secondary pdm-btn-sm" style="font-size: 0.8rem;">
                                    <i class="fas fa-eye"></i> Ver Detalhes
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
