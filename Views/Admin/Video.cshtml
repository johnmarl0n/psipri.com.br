@{
    ViewData["Title"] = "Vídeo Institucional";
    Layout = "_LayoutAdmin";
}

<div class="admin-header-flex" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
    <div>
        <h1 class="serif" style="margin-bottom: 5px;">Vídeo Institucional</h1>
        <p style="color: var(--text-muted); margin: 0;">Configure o vídeo de apresentação institucional exibido na página inicial.</p>
    </div>
    <a asp-action="Index" class="btn" style="background: #eee; color: var(--text-dark); padding: 12px 24px;">
        <i class="fas fa-arrow-left"></i> Voltar ao Painel
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 15px 20px; border-radius: 12px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-check-circle" style="font-size: 1.2rem;"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 15px 20px; border-radius: 12px; margin-bottom: 25px;">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-exclamation-circle"></i>
                <span>@error.ErrorMessage</span>
            </div>
        }
    </div>
}

<!-- Info Card: Recomendações YouTube Não Listado -->
<div style="background: #f8f9fa; border: 1px solid rgba(45, 62, 47, 0.12); border-left: 4px solid var(--secondary-color); border-radius: 12px; padding: 20px 25px; margin-bottom: 35px;">
    <div style="display: flex; align-items: flex-start; gap: 15px;">
        <i class="fab fa-youtube" style="font-size: 1.8rem; color: #cc181e; margin-top: 3px;"></i>
        <div>
            <h4 class="serif" style="margin: 0 0 8px; font-size: 1.2rem; color: var(--primary-color);">Dica para privacidade: Modo "Não Listado" (Unlisted)</h4>
            <p style="font-size: 0.92rem; color: var(--text-muted); margin: 0 0 10px; line-height: 1.6;">
                Ao publicar o vídeo no seu canal do YouTube, selecione a visibilidade como <strong>"Não Listado"</strong>. Dessa forma, ele <em>não</em> aparecerá nas buscas abertas do YouTube nem na página do canal, ficando reservado exclusivamente para os pacientes que visitarem o seu site.
            </p>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
                <strong>Formatos aceitos:</strong> <code>https://www.youtube.com/watch?v=...</code>, <code>https://youtu.be/...</code> ou links compartilhados pelo aplicativo do celular.
            </p>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 35px; align-items: start;">
    <!-- Formulário de Edição -->
    <div class="blog-card" style="padding: 30px;">
        <h3 class="serif" style="margin-bottom: 15px; font-size: 1.4rem;">Configuração do Link</h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 25px;">Cole o link do vídeo do YouTube abaixo. A alteração refletirá imediatamente na página inicial.</p>

        <form asp-action="UpdateVideo" method="post" id="videoForm">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom: 25px;">
                <label for="videoUrlInput" style="display: block; font-weight: 600; margin-bottom: 10px; font-size: 0.95rem; color: var(--text-dark);">
                    Link do Vídeo no YouTube
                </label>
                <div style="position: relative;">
                    <input 
                        type="text" 
                        name="videoUrl" 
                        id="videoUrlInput" 
                        value="@ViewBag.VideoUrl" 
                        placeholder="Ex: https://youtu.be/AbCdEf12345"
                        style="width: 100%; padding: 14px 16px 14px 44px; border-radius: 12px; border: 1px solid #ccc; font-size: 0.95rem; box-sizing: border-box; font-family: 'Inter', sans-serif;" 
                        autocomplete="off"
                    />
                    <i class="fab fa-youtube" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #cc181e; font-size: 1.1rem;"></i>
                </div>
                <small id="urlFeedback" style="display: block; margin-top: 8px; font-size: 0.82rem; color: var(--text-muted);"></small>
            </div>

            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <button type="submit" class="btn btn-primary-site" style="padding: 14px 28px;">
                    <i class="fas fa-save"></i> Salvar Vídeo
                </button>
                <a asp-action="Index" class="btn btn-outline" style="padding: 14px 24px;">Cancelar</a>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(ViewBag.VideoId))
        {
            <hr style="margin: 30px 0 20px; border: 0; border-top: 1px solid #eee;" />
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <span style="font-size: 0.85rem; color: var(--text-muted);">Deseja desativar o vídeo do site?</span>
                <form asp-action="RemoveVideo" method="post" onsubmit="return confirm('Tem certeza que deseja remover o vídeo institucional? A seção será ocultada na página inicial até que um novo vídeo seja salvo.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn" style="background: #fdf2f2; color: #dc2626; border: 1px solid #fecaca; padding: 10px 18px; font-size: 0.85rem;">
                        <i class="fas fa-trash-alt"></i> Remover Vídeo
                    </button>
                </form>
            </div>
        }
    </div>

    <!-- Pré-visualização Dinâmica -->
    <div class="blog-card" style="padding: 30px;">
        <h3 class="serif" style="margin-bottom: 10px; font-size: 1.4rem;">Pré-visualização do Vídeo</h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 20px;">Veja como o player será exibido para os visitantes do site:</p>

        <!-- Player Container -->
        <div id="previewContainer" style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 14px; background: #000; box-shadow: 0 10px 25px rgba(0,0,0,0.12); display: none;">
            <iframe 
                id="previewIframe" 
                src="" 
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
            </iframe>
        </div>

        <!-- Placeholder when empty -->
        <div id="previewPlaceholder" style="text-align: center; padding: 50px 20px; background: #fafafa; border: 2px dashed #ddd; border-radius: 14px;">
            <i class="fas fa-play-circle" style="font-size: 3rem; color: #ccc; margin-bottom: 15px;"></i>
            <h4 class="serif" style="color: var(--text-dark); margin-bottom: 8px;">Nenhum vídeo em exibição</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0; max-width: 320px; margin: 0 auto;">
                Cole o link do YouTube no formulário ao lado para carregar a prévia do player aqui em tempo real.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var input = document.getElementById('videoUrlInput');
            var previewContainer = document.getElementById('previewContainer');
            var previewIframe = document.getElementById('previewIframe');
            var previewPlaceholder = document.getElementById('previewPlaceholder');
            var feedback = document.getElementById('urlFeedback');

            var initialVideoId = '@(ViewBag.VideoId ?? "")';

            function extractYouTubeId(url) {
                if (!url) return null;
                url = url.trim();

                // Iframe check
                if (url.indexOf('<iframe') !== -1) {
                    var matchIframe = url.match(/src=["']([^"']+)["']/i);
                    if (matchIframe && matchIframe[1]) {
                        url = matchIframe[1];
                    }
                }

                // Direct 11-char ID
                if (/^[a-zA-Z0-9_-]{11}$/.test(url)) {
                    return url;
                }

                var match = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/|youtube\.com\/shorts\/)([^"&?\/\s]{11})/i);
                return (match && match[1]) ? match[1] : null;
            }

            function updatePreview() {
                var url = input.value.trim();
                var videoId = extractYouTubeId(url);

                if (videoId) {
                    var embedUrl = 'https://www.youtube-nocookie.com/embed/' + videoId + '?rel=0&modestbranding=1';
                    if (previewIframe.src !== embedUrl) {
                        previewIframe.src = embedUrl;
                    }
                    previewContainer.style.display = 'block';
                    previewPlaceholder.style.display = 'none';
                    feedback.innerHTML = '<span style="color: #1e7e34;"><i class="fas fa-check-circle"></i> ID identificado: <strong>' + videoId + '</strong></span>';
                } else if (url.length > 0) {
                    previewContainer.style.display = 'none';
                    previewIframe.src = '';
                    previewPlaceholder.style.display = 'block';
                    feedback.innerHTML = '<span style="color: #c5221f;"><i class="fas fa-exclamation-triangle"></i> Link não reconhecido como vídeo do YouTube. Verifique o endereço.</span>';
                } else {
                    previewContainer.style.display = 'none';
                    previewIframe.src = '';
                    previewPlaceholder.style.display = 'block';
                    feedback.innerHTML = '';
                }
            }

            input.addEventListener('input', updatePreview);
            input.addEventListener('paste', function() {
                setTimeout(updatePreview, 100);
            });

            // Initial load
            if (initialVideoId) {
                updatePreview();
            }
        })();
    </script>
}
