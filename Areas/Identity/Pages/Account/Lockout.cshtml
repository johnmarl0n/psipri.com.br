@page
@model psipri.com.br.Areas.Identity.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "Conta Bloqueada";
}

<div style="text-align: center;">
    <div style="width: 70px; height: 70px; background: rgba(220, 53, 69, 0.1); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
        <i class="fas fa-user-lock" style="font-size: 2rem; color: #dc3545;"></i>
    </div>
    
    <h1 class="serif" style="color: #dc3545; font-size: 1.8rem; margin-bottom: 15px;">@ViewData["Title"]</h1>
    
    <p style="color: var(--text-dark); font-size: 0.95rem; line-height: 1.6; margin-bottom: 25px;">
        Por motivos de segurança, esta conta foi temporariamente bloqueada após múltiplas tentativas consecutivas de acesso incorretas.
    </p>

    <div style="background: #fff8f8; border: 1px solid #f5c6cb; border-radius: 12px; padding: 15px; margin-bottom: 25px; font-size: 0.85rem; color: #721c24; text-align: left;">
        <i class="fas fa-clock" style="margin-right: 5px;"></i>
        Por favor, aguarde <strong>15 minutos</strong> antes de tentar acessar novamente, ou redefina sua senha caso a tenha esquecido.
    </div>

    <div style="display: flex; flex-direction: column; gap: 10px;">
        <a asp-page="./ForgotPassword" class="btn-login" style="display: block; text-decoration: none; text-align: center; box-sizing: border-box; background: var(--primary-color);">
            <i class="fas fa-key"></i> Redefinir Senha
        </a>
        <a href="/" style="display: block; text-decoration: none; text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-top: 10px;">
            <i class="fas fa-arrow-left"></i> Voltar à Página Inicial
        </a>
    </div>
</div>
