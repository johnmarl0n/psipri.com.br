@page
@model psipri.com.br.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Acesso Negado";
}

<div style="text-align: center;">
    <div style="width: 70px; height: 70px; background: rgba(220, 53, 69, 0.1); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
        <i class="fas fa-ban" style="font-size: 2rem; color: #dc3545;"></i>
    </div>
    
    <h1 class="serif" style="color: #dc3545; font-size: 1.8rem; margin-bottom: 15px;">@ViewData["Title"]</h1>
    
    <p style="color: var(--text-dark); font-size: 0.95rem; line-height: 1.6; margin-bottom: 25px;">
        Você não possui permissão para acessar este recurso.
    </p>

    <div style="display: flex; flex-direction: column; gap: 10px;">
        <a asp-page="./Login" class="btn-login" style="display: block; text-decoration: none; text-align: center; box-sizing: border-box;">
            <i class="fas fa-sign-in-alt"></i> Fazer Login
        </a>
        <a href="/" style="display: block; text-decoration: none; text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-top: 10px;">
            <i class="fas fa-arrow-left"></i> Voltar à Página Inicial
        </a>
    </div>
</div>
