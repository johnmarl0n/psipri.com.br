@page
@model psipri.com.br.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir Senha";
}

<h1 class="serif" style="color: var(--primary-color); font-size: 1.8rem; margin-bottom: 20px; text-align: center;">@ViewData["Title"]</h1>

<form method="post" asp-antiforgery="true">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 15px; font-size: 0.9rem;"></div>
    <input asp-for="Input.Code" type="hidden" />

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label" style="font-weight: 600; font-size: 0.9rem; color: var(--text-dark);">E-mail</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Seu e-mail cadastrado" />
        <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.8rem;"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label" style="font-weight: 600; font-size: 0.9rem; color: var(--text-dark);">Nova Senha</label>
        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Mínimo 8 caracteres" />
        <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.8rem;"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label" style="font-weight: 600; font-size: 0.9rem; color: var(--text-dark);">Confirmar Nova Senha</label>
        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Repita a nova senha" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
    </div>

    <div>
        <button type="submit" class="btn-login" style="margin-top: 10px;">Salvar Nova Senha</button>
    </div>

    <div class="footer-link" style="margin-top: 25px; text-align: center;">
        <p>
            <a asp-page="./Login" style="color: var(--primary-color); font-weight: 600;">Voltar ao Login</a>
        </p>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
