@page
@model psipri.com.br.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueceu sua senha?";
}

<h1 class="serif" style="color: var(--primary-color); font-size: 2rem; margin-bottom: 20px;">@ViewData["Title"]</h1>
<p style="margin-bottom: 20px; font-size: 0.95rem; color: var(--text-dark); opacity: 0.8;">
    Insira seu e-mail para receber um link de redefinição de senha.
</p>

<form method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert" style="margin-bottom: 15px; font-size: 0.9rem;"></div>
    
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label" style="font-weight: 600; font-size: 0.9rem; color: var(--text-dark);">E-mail</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Ex: nome@email.com" />
        <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.8rem;"></span>
    </div>
    
    <button type="submit" class="btn-login">Enviar Link</button>
    
    <div class="footer-link" style="margin-top: 25px;">
        <p>
            <a asp-page="./Login" style="color: var(--primary-color); font-weight: 600;">Voltar para o Login</a>
        </p>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
