@page
@{
    ViewData["Title"] = "E-mail Enviado";
}

<h1 class="serif" style="color: var(--primary-color); font-size: 2rem; margin-bottom: 20px;">@ViewData["Title"]</h1>
<p style="margin-bottom: 25px; font-size: 0.95rem; color: var(--text-dark); opacity: 0.8;">
    Se o e-mail informado estiver cadastrado, você receberá um link para redefinir sua senha em instantes.
</p>

<div class="footer-link">
    <p>
        <a asp-page="./Login" style="color: var(--primary-color); font-weight: 600;">Voltar para o Login</a>
    </p>
</div>
